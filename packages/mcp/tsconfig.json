{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "declaration": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "rootDir": "..",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "../world-core/src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
