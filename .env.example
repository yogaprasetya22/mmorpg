# ==============================================================================
# MMORPG VPS Deployment Environment Configurations
# ==============================================================================
# Copy this file to '.env' at the root before running 'docker compose build'
#
# $ cp .env.example .env
#
# Replace 'vps-ip-or-domain' with your actual VPS public IP address or domain.
# ==============================================================================

NEXT_PUBLIC_API_URL=http://localhost:18088 # Ganti 'localhost' dengan IP/domain VPS Anda (misal: 103.185.x.x) jika deploy ke production VPS
NEXT_PUBLIC_WS_URL=ws://localhost:18088/ws # Ganti 'localhost' dengan IP/domain VPS Anda (misal: 103.185.x.x) jika deploy ke production VPS
